# Postgres (docker compose up -d starts one on 54350)
DATABASE_URL=postgres://awaken:awaken@localhost:54350/awaken

# Better Auth — generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=replace-me-with-32-random-bytes
BETTER_AUTH_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Set to "true" to require verified email before login (needs a real mail transport in production)
REQUIRE_EMAIL_VERIFICATION=false
