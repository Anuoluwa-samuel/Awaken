# ── Development (docker compose up -d starts Postgres on 54350) ───────────────
DATABASE_URL=postgres://awaken:awaken@localhost:54350/awaken

# Better Auth — generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=replace-me-with-32-random-bytes
BETTER_AUTH_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000

# "true" requires a verified email before sign-in (needs an email provider in production)
REQUIRE_EMAIL_VERIFICATION=false

# ── Production (see docs/DEPLOYMENT.md) ─────────────────────────────────────
# Neon: the app uses the *pooled* string (host contains -pooler);
# migrations and seeding use the *direct* one.
# DATABASE_URL=postgresql://USER:PASSWORD@ep-xxx-pooler.REGION.aws.neon.tech/awaken?sslmode=require
# MIGRATION_DATABASE_URL=postgresql://USER:PASSWORD@ep-xxx.REGION.aws.neon.tech/awaken?sslmode=require

# Resend (https://resend.com): API key + a sender on a verified domain.
# RESEND_API_KEY=re_...
# EMAIL_FROM=AWAKEN <system@your-domain.com>

# Optional
# DATABASE_POOL_MAX=1          # per instance; defaults to 1 on Vercel, 10 elsewhere
# AUTH_IP_HEADER=x-real-ip     # off Vercel: the client-IP header your proxy overwrites

# Anti-spam. Minimum seconds between opening the sign-up form and submitting it (default 3).
# SIGN_UP_MIN_SECONDS=3
# Vercel BotID on sign-up, sign-in and password reset. Only works on Vercel; see
# docs/DEPLOYMENT.md ("Bot protection") before turning it on.
# NEXT_PUBLIC_BOTID_ENABLED=false

# Captcha: Cloudflare Turnstile. Free. Set both, or neither. See docs/DEPLOYMENT.md.
# NEXT_PUBLIC_TURNSTILE_SITE_KEY=
# TURNSTILE_SECRET_KEY=

# Cost controls. Site-wide budgets per UTC day; 0 turns the thing off.
# EMAIL_DAILY_BUDGET=90
# SIGNUP_DAILY_BUDGET=500
# READ_CACHE_SECONDS=30        # how long leaderboard and admin figures are reused
# CRON_SECRET=                 # 16+ characters: enables the daily clean-up job and reminders

# Evening push reminders (opt-in per player). `pnpm push:keys` prints a pair. Set both, or neither.
# The hourly trigger is .github/workflows/reminders.yml, with GitHub secrets SITE_URL and CRON_SECRET.
# SYSTEM_EVENTS=on            # "off" pauses surprise double-XP quests
# NEXT_PUBLIC_VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
