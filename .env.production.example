# Copy to .env.production on the VM (git-ignored; never commit it). Used two ways:
#  - the app container reads it via docker-compose.prod.yml's `env_file:`
#  - `docker compose --env-file .env.production ...` also fills in ${...} inside that file
#    itself (POSTGRES_PASSWORD, CADDY_NETWORK)
# chmod 600 it once filled in.

# ── Postgres (awaken-db container) ──────────────────────────────────────────
POSTGRES_USER=awaken
POSTGRES_PASSWORD=                    # openssl rand -base64 24
POSTGRES_DB=awaken

# The app reaches Postgres by the compose service name, over the internal Docker network —
# no sslmode needed, it never leaves the host.
DATABASE_URL=postgres://awaken:SAME_AS_POSTGRES_PASSWORD@awaken-db:5432/awaken
MIGRATION_DATABASE_URL=postgres://awaken:SAME_AS_POSTGRES_PASSWORD@awaken-db:5432/awaken

# ── Caddy ────────────────────────────────────────────────────────────────────
# Run `docker network ls` on the VM and put your existing Caddy's network name here.
CADDY_NETWORK=caddy_net

# ── Better Auth ──────────────────────────────────────────────────────────────
BETTER_AUTH_SECRET=                   # openssl rand -base64 32 — new, production-only
BETTER_AUTH_URL=https://getawaken.com.ng
NEXT_PUBLIC_APP_URL=https://getawaken.com.ng
REQUIRE_EMAIL_VERIFICATION=false      # true once RESEND_API_KEY + EMAIL_FROM are set

# ── Resend (optional until you do the email step in docs/DEPLOYMENT.md) ──────
# RESEND_API_KEY=re_...
# EMAIL_FROM=AWAKEN <system@getawaken.com.ng>

# ── Reverse proxy / rate limiting ───────────────────────────────────────────
# Must match what the Caddyfile explicitly sets (see docs/DEPLOYMENT.md) — not a header a
# client could set itself.
AUTH_IP_HEADER=x-forwarded-for

# ── Cron (GitHub Actions calls these; same value as the SITE_URL/CRON_SECRET repo secrets) ──
CRON_SECRET=                          # openssl rand -base64 32

# ── Optional ─────────────────────────────────────────────────────────────────
# NEXT_PUBLIC_TURNSTILE_SITE_KEY=
# TURNSTILE_SECRET_KEY=
# NEXT_PUBLIC_VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# EMAIL_DAILY_BUDGET=90
# SIGNUP_DAILY_BUDGET=500
# READ_CACHE_SECONDS=30
# DATABASE_POOL_MAX=10
